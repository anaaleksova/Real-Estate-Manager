{
    "ConnectionStrings": {
        "DefaultConnection": "#{ConnectionString}#"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "MailSettings": {
        "SmtpServer": "#{SmtpServer}#",
        "SmtpUserName": "#{SmtpUserName}#",
        "SmtpPassword": "#{SmtpPassword}#"
    },
    "AllowedHosts": "*"
}