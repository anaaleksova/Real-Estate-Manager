@model RealEstate.Domain.DomainModels.Appointment
@{
    ViewData["Title"] = "Delete Appointment";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Delete Appointment</h2>
        <a href="@Url.Action("MyAppointments")" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to My Appointments
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-exclamation-triangle"></i>
                        Are you sure you want to delete this appointment?
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6 class="text-primary"><i class="fas fa-info-circle"></i> Appointment Details</h6>
                            <table class="table table-sm">
                                <tr>
                                    <td><strong>Date & Time:</strong></td>
                                    <td>
                                        @Model.ScheduledDate.ToString("dddd, dd MMMM yyyy")<br>
                                        <span class="text-primary">@Model.ScheduledDate.ToString("HH:mm")</span>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Status:</strong></td>
                                    <td>
                                        <span>
                                            @Model.Status
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Agent:</strong></td>
                                    <td>
                                        @Model.Agent?.Name<br>
                                        <small class="text-muted">@Model.Agent?.Email</small>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-primary"><i class="fas fa-home"></i> Property Details</h6>
                            <table class="table table-sm">
                                <tr>
                                    <td><strong>Property:</strong></td>
                                    <td>@Model.Property?.Title</td>
                                </tr>
                                <tr>
                                    <td><strong>Address:</strong></td>
                                    <td>@Model.Property?.Address</td>
                                </tr>
                                <tr>
                                    <td><strong>Price:</strong></td>
                                    <td>$@Model.Property?.Price.ToString("N0")</td>
                                </tr>
                                <tr>
                                    <td><strong>Status:</strong></td>
                                    <td>
                                        <span>
                                            @Model.Property?.Status
                                        </span>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <a href="@Url.Action("MyAppointments")" class="btn btn-secondary btn-lg">
                            <i class="fas fa-times"></i> Cancel
                        </a>

                        <form method="post" style="display: inline;">
                            <input type="hidden" asp-for="Id" />
                            <button type="submit" class="btn btn-danger btn-lg">
                                <i class="fas fa-trash"></i> Yes, Delete Permanently
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>